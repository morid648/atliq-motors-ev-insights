// =============================================================================
// DAX Calculation Engine: AtliQ Motors EV Insights
// Data Model: Star Schema fed from PostgreSQL staging
// Fixes Applied: Corrected '2024 Revenue' filter from 2023 to 2024 (Defect D1)
// Price Assumption: 2-Wheelers = INR 1,00,000; 4-Wheelers = INR 15,00,000 (Rule R9)
// =============================================================================

// -----------------------------------------------------------------------------
// 1. Core Volume Measures
// -----------------------------------------------------------------------------

2 Wheelers Sold = 
CALCULATE(
    SUM(electric_vehicle_sales_by_makers[electric_vehicles_sold]),
    electric_vehicle_sales_by_makers[vehicle_category] = "2-Wheelers"
)

4 Wheelers Sold = 
CALCULATE(
    SUM(electric_vehicle_sales_by_makers[electric_vehicles_sold]),
    electric_vehicle_sales_by_makers[vehicle_category] = "4-Wheelers"
)

Total EV sales per makers = 
SUM(electric_vehicle_sales_by_makers[electric_vehicles_sold])

Total EV Sales per State = 
SUM(electric_vehicle_sales_by_state[electric_vehicles_sold])

Total sales per state = 
SUM(electric_vehicle_sales_by_state[total_vehicles_sold])


// -----------------------------------------------------------------------------
// 2. Penetration Rate Measures
// -----------------------------------------------------------------------------

Penetration Rate = 
DIVIDE(
    SUM(electric_vehicle_sales_by_state[electric_vehicles_sold]), 
    SUM(electric_vehicle_sales_by_state[total_vehicles_sold]),
    0
)

Penetration Rate 2022 = 
CALCULATE([Penetration Rate], dim_date[fiscal_year] = 2022)

Penetration Rate 2023 = 
CALCULATE([Penetration Rate], dim_date[fiscal_year] = 2023)

Penetration Rate 2024 = 
CALCULATE([Penetration Rate], dim_date[fiscal_year] = 2024)

Penetration Rate Change(22-23) = 
[Penetration Rate 2023] - [Penetration Rate 2022]

Penetration Rate Change(23-24) = 
[Penetration Rate 2024] - [Penetration Rate 2023]

Overall Penetration Rate Change(22-24) = 
[Penetration Rate Change(22-23)] + [Penetration Rate Change(23-24)]


// -----------------------------------------------------------------------------
// 3. CAGR Measures (Periods = 2 for FY2022 -> FY2024)
// -----------------------------------------------------------------------------

CAGR For Makers = 
VAR EndValue = CALCULATE([Total EV sales per makers], dim_date[fiscal_year] = 2024)
VAR StartValue = CALCULATE([Total EV sales per makers], dim_date[fiscal_year] = 2022)
VAR Periods = 2
RETURN
IF(
    StartValue > 0 && EndValue > 0, 
    ((EndValue / StartValue) ^ (1 / Periods)) - 1, 
    BLANK()
)

CAGR EV Sales For States = 
VAR EndValue = CALCULATE([Total EV Sales per State], dim_date[fiscal_year] = 2024)
VAR StartValue = CALCULATE([Total EV Sales per State], dim_date[fiscal_year] = 2022)
VAR Periods = 2
RETURN
IF(
    StartValue > 0 && EndValue > 0, 
    ((EndValue / StartValue) ^ (1 / Periods)) - 1, 
    BLANK()
)

CAGR For States = 
VAR EndValue = CALCULATE([Total sales per state], dim_date[fiscal_year] = 2024)
VAR StartValue = CALCULATE([Total sales per state], dim_date[fiscal_year] = 2022)
VAR Periods = 2
RETURN
IF(
    StartValue > 0 && EndValue > 0, 
    ((EndValue / StartValue) ^ (1 / Periods)) - 1, 
    BLANK()
)


// -----------------------------------------------------------------------------
// 4. Revenue Measures & Growth Rates (Corrected D1 Fix)
// -----------------------------------------------------------------------------

2022 Revenue = 
CALCULATE(
    SUMX(
        'electric_vehicle_sales_by_makers',
        'electric_vehicle_sales_by_makers'[electric_vehicles_sold]
            * LOOKUPVALUE('dim_revenue'[average_price], 'dim_revenue'[vehicle_category], 'electric_vehicle_sales_by_makers'[vehicle_category])
    ),
    dim_date[fiscal_year] = 2022
)

2023 Revenue = 
CALCULATE(
    SUMX(
        'electric_vehicle_sales_by_makers',
        'electric_vehicle_sales_by_makers'[electric_vehicles_sold]
            * LOOKUPVALUE('dim_revenue'[average_price], 'dim_revenue'[vehicle_category], 'electric_vehicle_sales_by_makers'[vehicle_category])
    ),
    dim_date[fiscal_year] = 2023
)

// Defect D1 Resolved: Corrected filter from dim_date[fiscal_year] = 2023 to 2024
2024 Revenue = 
CALCULATE(
    SUMX(
        'electric_vehicle_sales_by_makers',
        'electric_vehicle_sales_by_makers'[electric_vehicles_sold]
            * LOOKUPVALUE('dim_revenue'[average_price], 'dim_revenue'[vehicle_category], 'electric_vehicle_sales_by_makers'[vehicle_category])
    ),
    dim_date[fiscal_year] = 2024
)

Total Revenue = 
SUMX(
    'electric_vehicle_sales_by_makers',
    'electric_vehicle_sales_by_makers'[electric_vehicles_sold]
        * LOOKUPVALUE('dim_revenue'[average_price], 'dim_revenue'[vehicle_category], 'electric_vehicle_sales_by_makers'[vehicle_category])
)

Revenue Growth Rate 2022-2023 = 
DIVIDE([2023 Revenue] - [2022 Revenue], [2022 Revenue], 0)

Revenue Growth Rate 2022-2024 = 
DIVIDE([2024 Revenue] - [2022 Revenue], [2022 Revenue], 0)

Revenue Growth Rate 2023-2024 = 
DIVIDE([2024 Revenue] - [2023 Revenue], [2023 Revenue], 0)


// -----------------------------------------------------------------------------
// 5. 2030 Projections (Answers P9)
// Note: Constant-CAGR historical extrapolation (Rule R5)
// -----------------------------------------------------------------------------

Projected EV Sales 2030 = 
VAR CurrentYear = 2024
VAR FutureYear = 2030
VAR YearsToProject = FutureYear - CurrentYear
VAR CurrentEVSales = CALCULATE([Total EV Sales per State], dim_date[fiscal_year] = CurrentYear)
VAR CAGREVSales = [CAGR EV Sales For States]
RETURN
IF(
    NOT ISBLANK(CAGREVSales),
    CurrentEVSales * ((1 + CAGREVSales) ^ YearsToProject),
    BLANK()
)
