# Raw dataset files (codebasics.io terms prohibit distribution)
datasets/*.csv
*.csv

# Python caches and virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Database and log artifacts
*.log
*.sqlite
*.db

# Operating System and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
